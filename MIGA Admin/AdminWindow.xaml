<Window x:Class="MIGA_Agent.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:MIGA_Agent.Helpers" Title="MIGA Admin" Width="980" Height="540" MinWidth="770" MinHeight="490" Icon="/Icon.ico" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="Добавить сервер" Click="Add_Click" Padding="12,6" Margin="0,0,8,0"/>
      <Button Content="Сохранить сейчас" Click="Save_Click" Padding="12,6" Margin="0,0,8,0"/>
      <Button Content="Удалить сервер из списка" Click="Remove_Click" Padding="12,6"/>

    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" TextAlignment="Right" Margin="0,8,0,0">
      <Hyperlink NavigateUri="https://github.com/exzod-ik/miga" RequestNavigate="ProjectLink_RequestNavigate">GitHub</Hyperlink>
    </TextBlock>
    <ListBox x:Name="Notifications" DockPanel.Dock="Bottom" MaxHeight="60" Margin="0,8,0,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
          <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </ListBox.Style>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid>
      <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                            Focusable="False" PanningMode="HorizontalOnly">
                <TabPanel IsItemsHost="True"/>
              </ScrollViewer>
              <Border Grid.Row="1" Style="{StaticResource TabPageFrame}">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </TabControl.Template>
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" MaxWidth="196" TextTrimming="CharacterEllipsis" Margin="8,4">
              <TextBlock.ToolTip>
                <TextBlock Text="{Binding DisplayName}" MaxWidth="360" TextWrapping="Wrap"/>
              </TextBlock.ToolTip>
            </TextBlock>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate><DataTemplate>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="8,12,8,0" IsEnabled="{Binding IsNotBusy}"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Название сервера"/><TextBox Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Адрес сервера"/><TextBox Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSshConnected}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Пользователь SSH"/><TextBox Text="{Binding ServerSshUser, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSshConnected}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Пароль SSH" ToolTip="Не сохраняется"/><PasswordBox helpers:PasswordBoxAssistant.BindPassword="true" helpers:PasswordBoxAssistant.BoundPassword="{Binding ServerSshPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
              </Grid>
              <TextBlock Text="{Binding ServerDemoStatus}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="{Binding SshButtonText}" Command="{Binding ToggleSshCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Обновить статус" Command="{Binding RefreshServerDemoStatusCommand}" IsEnabled="{Binding IsSshConnected}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{Binding DynamicDemoButtonText}" Command="{Binding DynamicDemoCommand}" IsEnabled="{Binding IsSshConnected}" Padding="12,6"/>
              </WrapPanel>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="Клиенты, приглашения и лимиты" Command="{Binding ManageClientsCommand}" IsEnabled="{Binding IsSshConnected}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Диагностика сервера" Command="{Binding OpenDiagnosticsCommand}" IsEnabled="{Binding IsSshConnected}" Padding="12,6"/>
              </WrapPanel>
              <GroupBox Header="Настройки сервера" IsEnabled="{Binding IsSshConnected}">
                <StackPanel Margin="10">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                      <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="188"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Уровень журналирования"/>
                      <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding ServerLogLevel}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="DNS-сервер"/>
                      <TextBox Text="{Binding DnsServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" MaxWidth="280" HorizontalAlignment="Left" MinWidth="180"/>
                    </StackPanel>
                  </Grid>
                  <Button Content="Применить настройки к серверу" Command="{Binding ApplyServerSettingsCommand}" HorizontalAlignment="Left" Padding="12,6"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate></TabControl.ContentTemplate>
      </TabControl>
      <TextBlock Text="Добавьте сервер для подключения по SSH." Margin="0,4,0,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasItems, ElementName=Tabs}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</Window>

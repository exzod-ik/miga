<Window x:Class="MIGA_Agent.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MIGA_Agent.Helpers"
        xmlns:services="clr-namespace:MIGA_Agent.Services"
        Title="{Binding WindowTitle}"
        Height="650" Width="1060" MinHeight="645" MinWidth="855"
        Icon="/Icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RefreshButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 13,5 A 6,6 0 1 0 14,10 M 13,1 L 13,5 L 9,5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RedirectHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedirectItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsEnabled"
                    Value="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConflicting}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ConflictTooltip}"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedirectListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="MaxHeight" Value="Infinity"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RedirectItemStyle}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ContextMenuService.IsEnabled"
                    Value="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Focusable" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedirectActionsStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="IsEnabled"
                    Value="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="RedirectButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <DataTemplate x:Key="RedirectRuleTemplate">
            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="0,0,16,0">
                <Label Content="Режим перенаправления" Target="{Binding ElementName=RoutingModeBox}" Padding="0,0,0,4"/>
                <ComboBox x:Name="RoutingModeBox" MinWidth="224" SelectedValuePath="Tag"
                          SelectedValue="{Binding RoutingMode}">
                    <ComboBoxItem Content="Раздельный (рекомендуемый)" Tag="split"/>
                    <ComboBoxItem Content="Полный" Tag="full"/>
                </ComboBox>
            </StackPanel>
            <StackPanel IsEnabled="{Binding IsFullRouting}">
                <Label Content="Сервер перенаправления" Target="{Binding ElementName=RoutingServerBox}" Padding="0,0,0,4"/>
                <ComboBox x:Name="RoutingServerBox" Width="280" ItemsSource="{Binding Servers}"
                          SelectedItem="{Binding FullRoutingServer}"
                          IsSynchronizedWithCurrentItem="False">
                    <ComboBox.ToolTip>
                        <TextBlock Text="{Binding FullRoutingServer.DisplayName}" MaxWidth="360" TextWrapping="Wrap"/>
                    </ComboBox.ToolTip>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" MaxWidth="250" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="360" TextWrapping="Wrap"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding CanUseForFullRouting}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
            <CheckBox Content="Встроенный DNS-резолвер" IsChecked="{Binding DnsResolverEnabled}"
                      IsEnabled="{Binding CanEditRules}"
                      ToolTip="Выдаёт виртуальные IPv4 из 198.18.0.0/15 для выбора DNS по маршруту приложения. Для сетей, использующих этот диапазон, оставьте настройку выключенной."
                      Margin="16,0,0,0" VerticalAlignment="Bottom" VerticalContentAlignment="Center" Padding="8,0,0,0"/>
        </WrapPanel>

        <TabControl Grid.Row="1" Margin="0,0,0,10"
                    ItemsSource="{Binding Servers}"
                    SelectedItem="{Binding SelectedServer}"
                    SelectionChanged="ServerTabs_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right" Content="+ Добавить подключение"
                                    Command="{Binding AddServerCommand}" VerticalAlignment="Top"
                                    Padding="12,5" Margin="8,2,0,0"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" PanningMode="HorizontalOnly">
                                <TabPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </DockPanel>
                        <Border Grid.Row="1">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel MaxWidth="196" Margin="5,0">
                        <DockPanel.ToolTip>
                            <TextBlock Text="{Binding TabTitle}" MaxWidth="360" TextWrapping="Wrap"/>
                        </DockPanel.ToolTip>
                        <TextBlock DockPanel.Dock="Right" Text=" · отключён">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TabPageFrame}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <Label Content="Название подключения" Target="{Binding ElementName=ConnectionNameBox}" Padding="0,0,0,4"/>
                                    <TextBox x:Name="ConnectionNameBox" Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <DockPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <Button DockPanel.Dock="Right" Command="{Binding CheckProtocolV2StatusCommand}"
                                            Style="{StaticResource RefreshButtonStyle}" IsEnabled="{Binding IsNotBusy}"
                                            ToolTip="Обновить статус туннеля" AutomationProperties.Name="Обновить статус туннеля"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="54" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayedConnectionStatus}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <CheckBox Content="Использовать сервер" IsChecked="{Binding Enabled}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Menu IsEnabled="{Binding IsNotBusy}" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <MenuItem Header="{Binding InvitationMenuTitle}" Padding="12,6" MinHeight="32">
                                            <MenuItem Header="Файл" Command="{Binding ImportInvitationCommand}"/>
                                            <MenuItem Header="Текст" Command="{Binding PasteInvitationCommand}"/>
                                            <MenuItem Header="Изображение QR-кода" Command="{Binding ImportQrCommand}"/>
                                        </MenuItem>
                                    </Menu>
                                    <Button Content="Поделиться" Command="{Binding ShareInvitationCommand}" IsEnabled="{Binding IsNotBusy}"
                                            Padding="12,5" MinHeight="32" Margin="0,0,6,0"/>
                                    <Button Content="Диагностика подключения" Command="{Binding OpenDiagnosticsCommand}"
                                            Padding="12,5" MinHeight="32" Margin="0,0,6,0"/>
                                    <Button Content="Удалить подключение" Command="{Binding RemoveServerCommand}"
                                            Padding="12,5" MinHeight="32"/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Правила раздельного перенаправления" FontSize="17" FontWeight="SemiBold"
                                           Margin="0,0,0,8" Style="{StaticResource RedirectHeadingStyle}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Процессы" TextWrapping="NoWrap" Margin="0,0,0,5" Style="{StaticResource RedirectHeadingStyle}"/>
                                        <ListBox Grid.Row="1" x:Name="RedirectProcessesListBox" ItemsSource="{Binding RedirectProcesses}"
                                                 Style="{StaticResource RedirectListStyle}" ItemTemplate="{StaticResource RedirectRuleTemplate}">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Добавить" Command="{Binding AddProcessCommand}"/>
                                                    <MenuItem Header="Изменить" Command="{Binding EditProcessCommand}"/>
                                                    <MenuItem Header="Удалить" Command="{Binding RemoveProcessCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Style="{StaticResource RedirectActionsStyle}">
                                            <Button Content="Добавить" Command="{Binding AddProcessCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Изменить" Command="{Binding EditProcessCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Удалить" Command="{Binding RemoveProcessCommand}" CommandParameter="{Binding SelectedItem, ElementName=RedirectProcessesListBox}" Style="{StaticResource RedirectButtonStyle}" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="0,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Доменные имена" TextWrapping="NoWrap" Margin="0,0,0,5" Style="{StaticResource RedirectHeadingStyle}"/>
                                        <ListBox Grid.Row="1" x:Name="RedirectDomainsListBox" ItemsSource="{Binding RedirectDomains}"
                                                 Style="{StaticResource RedirectListStyle}" ItemTemplate="{StaticResource RedirectRuleTemplate}">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Добавить" Command="{Binding AddDomainCommand}"/>
                                                    <MenuItem Header="Изменить" Command="{Binding EditDomainCommand}"/>
                                                    <MenuItem Header="Удалить" Command="{Binding RemoveDomainCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Style="{StaticResource RedirectActionsStyle}">
                                            <Button Content="Добавить" Command="{Binding AddDomainCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Изменить" Command="{Binding EditDomainCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Удалить" Command="{Binding RemoveDomainCommand}" CommandParameter="{Binding SelectedItem, ElementName=RedirectDomainsListBox}" Style="{StaticResource RedirectButtonStyle}" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="IP адреса (IP или диапазоны)" TextWrapping="NoWrap" Margin="0,0,0,5" Style="{StaticResource RedirectHeadingStyle}"/>
                                        <ListBox Grid.Row="1" x:Name="RedirectIpsListBox" ItemsSource="{Binding RedirectIps}"
                                                 Style="{StaticResource RedirectListStyle}" ItemTemplate="{StaticResource RedirectRuleTemplate}">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Добавить" Command="{Binding AddIpCommand}"/>
                                                    <MenuItem Header="Изменить" Command="{Binding EditIpCommand}"/>
                                                    <MenuItem Header="Удалить" Command="{Binding RemoveIpCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Style="{StaticResource RedirectActionsStyle}">
                                            <Button Content="Добавить" Command="{Binding AddIpCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Изменить" Command="{Binding EditIpCommand}" Style="{StaticResource RedirectButtonStyle}"/>
                                            <Button Content="Удалить" Command="{Binding RemoveIpCommand}" CommandParameter="{Binding SelectedItem, ElementName=RedirectIpsListBox}" Style="{StaticResource RedirectButtonStyle}" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <Button Content="Применить конфигурацию" Command="{Binding ApplyConfigurationCommand}" Padding="10,5" Margin="0,0,8,0"/>
                    <TextBlock Text="Лог" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                              Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="Уровень логирования клиента" AutomationProperties.Name="Уровень логирования клиента"/>
                    <TextBlock Text="MSS" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding TunnelMaxMss, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Width="70" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip="TCP MSS: целое число от 1 до 65535. По умолчанию 1400."
                             AutomationProperties.Name="TCP MSS клиента"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,12,0"/>
                    <TextBlock Text="Служба MigaClient:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ServiceStatus}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Запустить" Command="{Binding StartLocalServiceCommand}" MinWidth="90" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="Остановить" Command="{Binding StopLocalServiceCommand}" MinWidth="95" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Command="{Binding RefreshServiceStatusCommand}" Style="{StaticResource RefreshButtonStyle}"
                            ToolTip="Обновить статус службы" AutomationProperties.Name="Обновить статус службы"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,8">
                <Hyperlink NavigateUri="https://github.com/exzod-ik/miga" RequestNavigate="ProjectLink_RequestNavigate">GitHub</Hyperlink>
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="2" MaxHeight="76" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <ItemsControl x:Name="NotificationList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202630" BorderBrush="#49515E" BorderThickness="1"
                                CornerRadius="10" Margin="2,0,2,8" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Background="#75A7F5"/>
                                <Grid Grid.Column="1" Margin="13,10,9,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon" Text="i" Foreground="#9AC1FF"
                                               FontSize="17" FontWeight="Bold" VerticalAlignment="Top"
                                               HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="#F7F9FC"
                                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#D1D8E1"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <ProgressBar x:Name="OperationProgress" IsIndeterminate="True"
                                                     Height="3" Margin="0,10,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="DismissButton" Grid.Column="2" Content="×" Width="26" Height="26"
                                            Padding="0" VerticalAlignment="Top"
                                            ToolTip="Закрыть уведомление"
                                            AutomationProperties.Name="Закрыть уведомление"
                                            Click="DismissNotification_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Warning}">
                                <Setter TargetName="Accent" Property="Background" Value="#F3B75E"/>
                                <Setter TargetName="Icon" Property="Text" Value="!"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#F3B75E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Error}">
                                <Setter TargetName="Accent" Property="Background" Value="#EF7D83"/>
                                <Setter TargetName="Icon" Property="Text" Value="×"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#EF7D83"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Success}">
                                <Setter TargetName="Accent" Property="Background" Value="#70D2A0"/>
                                <Setter TargetName="Icon" Property="Text" Value="✓"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#70D2A0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Progress}">
                                <Setter TargetName="Accent" Property="Background" Value="#9AC1FF"/>
                                <Setter TargetName="Icon" Property="Text" Value="…"/>
                                <Setter TargetName="OperationProgress" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="DismissButton" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <DebugType>none</DebugType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ru-RU</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.3.0</ProductVersion>
    <OutputName>MIGA-$(ProductVersion)-x64</OutputName>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\Build\MigaInstaller.Wix\payload</PayloadDir>
    <ClientPublishDir Condition="'$(ClientPublishDir)' == ''">$(MSBuildThisFileDirectory)..\Build\MIGA Agent\publish</ClientPublishDir>
    <AdminPublishDir Condition="'$(AdminPublishDir)' == ''">$(MSBuildThisFileDirectory)..\Build\MIGA Admin\publish</AdminPublishDir>
    <DotNetRuntimeVersion Condition="'$(DotNetRuntimeVersion)' == ''">10.0.14</DotNetRuntimeVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);ClientPublishDir=$(ClientPublishDir);AdminPublishDir=$(AdminPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build.ps1" />
    <None Include="prepare-runtime.ps1" />
    <None Include="License.rtf" />
    <None Include="logo.png" />
    <None Include="TopBanner.png" />
    <None Include="DialogBackground.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)\miga_client.exe') Or !Exists('$(PayloadDir)\miga_server')" Text="Payload missing. Run build.ps1 in MigaInstaller.Wix first." />
    <Error Condition="!Exists('$(PayloadDir)\Diagnostics\miga_diagnostics.exe') Or Exists('$(PayloadDir)\Diagnostics\miga_diagnostics.dll') Or Exists('$(PayloadDir)\Diagnostics\coreclr.dll')" Text="Diagnostics single-file publication missing. Run build.ps1." />
    <Error Condition="!Exists('$(ClientPublishDir)\MIGA Client.exe')" Text="MIGA Client publication missing. Publish the Client before building the installer." />
    <Error Condition="Exists('$(ClientPublishDir)\MIGA Client.runtimeconfig.json') Or Exists('$(ClientPublishDir)\MIGA Client.dll') Or Exists('$(ClientPublishDir)\coreclr.dll')" Text="Client must be a single-file application using the private Runtime. Run build.ps1." />
    <Error Condition="Exists('$(PayloadDir)\MIGA Client.exe')" Text="Staging contains MIGA Agent. Run build.ps1 to create native-only staging." />
    <Error Condition="Exists('$(PayloadDir)\config.json')" Text="Refusing to package a local config.json." />
    <Error Condition="!Exists('$(AdminPublishDir)\MIGA Admin.exe') Or Exists('$(AdminPublishDir)\MIGA Admin.dll') Or Exists('$(AdminPublishDir)\coreclr.dll')" Text="Admin single-file publication missing. Run build.ps1." />
    <Error Condition="!Exists('$(PayloadDir)\Runtime\host\fxr\$(DotNetRuntimeVersion)\hostfxr.dll') Or !Exists('$(PayloadDir)\Runtime\shared\Microsoft.NETCore.App\$(DotNetRuntimeVersion)\coreclr.dll') Or !Exists('$(PayloadDir)\Runtime\shared\Microsoft.WindowsDesktop.App\$(DotNetRuntimeVersion)\PresentationFramework.dll')" Text="Private Core/Desktop runtime missing. Run build.ps1." />
  </Target>
</Project>

<Project Sdk="WixToolset.Sdk/7.0.0">
  <Import Project="..\Build\MigaInstaller.Wix\Payload.props" Condition="Exists('..\Build\MigaInstaller.Wix\Payload.props')" />
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ru-RU</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.2.3</ProductVersion>
    <OutputName>MIGA-$(ProductVersion)-x64</OutputName>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\Build\MigaInstaller.Wix\payload</PayloadDir>
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\Build\MIGA Agent\publish</AgentPublishDir>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);AgentPublishDir=$(AgentPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build.ps1" />
    <None Include="License.rtf" />
    <None Include="logo.png" />
    <None Include="TopBanner.png" />
    <None Include="DialogBackground.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)\miga_client.exe') Or !Exists('$(PayloadDir)\miga_server')" Text="Payload missing. Run build.ps1 in MigaInstaller.Wix first." />
    <Error Condition="!Exists('$(AgentPublishDir)\MIGA Agent.exe')" Text="MIGA Agent publication missing. Publish the Agent before building the installer." />
    <Error Condition="Exists('$(AgentPublishDir)\MIGA Agent.runtimeconfig.json') Or Exists('$(AgentPublishDir)\MIGA Agent.dll') Or Exists('$(AgentPublishDir)\coreclr.dll')" Text="Agent must be a self-contained single-file publication. Run build.ps1." />
    <Error Condition="Exists('$(PayloadDir)\MIGA Agent.exe')" Text="Staging contains MIGA Agent. Run build.ps1 to create native-only staging." />
    <Error Condition="Exists('$(PayloadDir)\config.json')" Text="Refusing to package a local config.json." />
  </Target>
</Project>
